# Generated by chezmoi from .chezmoidata/colors.toml
# See docs/colorscheme.md for reference

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#{{ .colors.ui.bg }}"

# Main text color (fg)
theme[main_fg]="#{{ .colors.ui.fg }}"

# Title color for boxes (fg)
theme[title]="#{{ .colors.ui.fg }}"

# Highlight color for keyboard shortcuts (blue)
theme[hi_fg]="#{{ .colors.syntax.function }}"

# Background color of selected item in processes box (surface_sunken)
theme[selected_bg]="#{{ .colors.ui.surface_sunken }}"

# Foreground color of selected item in processes box (blue)
theme[selected_fg]="#{{ .colors.syntax.function }}"

# Color of inactive/disabled text (border_muted)
theme[inactive_fg]="#{{ .colors.ui.border_muted }}"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling (coral)
theme[graph_text]="#{{ .colors.palette.coral }}"

# Background color of the percentage meters
theme[meter_bg]="#{{ .colors.ui.meter_bg }}"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text (coral)
theme[proc_misc]="#{{ .colors.palette.coral }}"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#{{ .colors.syntax.keyword }}"
theme[mem_box]="#{{ .colors.syntax.string }}"
theme[net_box]="#{{ .colors.syntax.function }}"
theme[proc_box]="#{{ .colors.syntax.number }}"

# Box divider line and small boxes line color (border_muted)
theme[div_line]="#{{ .colors.ui.border_muted }}"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#{{ .colors.syntax.string }}"
theme[temp_mid]="#{{ .colors.syntax.type }}"
theme[temp_end]="#{{ .colors.diagnostic.error }}"

# CPU graph colors (Teal -> Azure -> Lilac)
theme[cpu_start]="#{{ .colors.syntax.property }}"
theme[cpu_mid]="#{{ .colors.palette.azure }}"
theme[cpu_end]="#{{ .colors.palette.lilac }}"

# Mem/Disk free meter (Purple -> Lilac -> Blue)
theme[free_start]="#{{ .colors.syntax.keyword }}"
theme[free_mid]="#{{ .colors.palette.lilac }}"
theme[free_end]="#{{ .colors.syntax.function }}"

# Mem/Disk cached meter (Azure -> Blue -> Lilac)
theme[cached_start]="#{{ .colors.palette.azure }}"
theme[cached_mid]="#{{ .colors.syntax.function }}"
theme[cached_end]="#{{ .colors.palette.lilac }}"

# Mem/Disk available meter (Orange -> Red-soft -> Red)
theme[available_start]="#{{ .colors.syntax.number }}"
theme[available_mid]="#{{ .colors.palette.red_soft }}"
theme[available_end]="#{{ .colors.diagnostic.error }}"

# Mem/Disk used meter (Green -> Teal -> Cyan)
theme[used_start]="#{{ .colors.syntax.string }}"
theme[used_mid]="#{{ .colors.syntax.property }}"
theme[used_end]="#{{ .colors.ansi.cyan }}"

# Download graph colors (Orange -> Red-soft -> Red)
theme[download_start]="#{{ .colors.syntax.number }}"
theme[download_mid]="#{{ .colors.palette.red_soft }}"
theme[download_end]="#{{ .colors.diagnostic.error }}"

# Upload graph colors (Green -> Teal -> Cyan)
theme[upload_start]="#{{ .colors.syntax.string }}"
theme[upload_mid]="#{{ .colors.syntax.property }}"
theme[upload_end]="#{{ .colors.ansi.cyan }}"

# Process box color gradient for threads, mem and cpu usage (Azure -> Lilac -> Purple)
theme[process_start]="#{{ .colors.palette.azure }}"
theme[process_mid]="#{{ .colors.palette.lilac }}"
theme[process_end]="#{{ .colors.syntax.keyword }}"
